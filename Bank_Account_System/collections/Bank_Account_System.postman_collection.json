{
  "info": {
    "name": "Horizon Bank Account System",
    "description": "Core account, transfer and statement API examples. Seed data is loaded from db/02_seed.sql.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key":"baseUrl","value":"http://localhost:8080/api/v1"},
    {"key":"accountNumber","value":"501000000001"},
    {"key":"toAccountNumber","value":"501000000002"},
    {"key":"referenceNo","value":""},
    {"key":"idempotencyKey","value":"postman-transfer-demo-001"}
  ],
  "item": [
    {"name":"Health","request":{"method":"GET","url":"{{baseUrl}}/health"}},
    {"name":"Get account","request":{"method":"GET","url":"{{baseUrl}}/accounts/{{accountNumber}}"}},
    {"name":"Open account","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"customer\": {\n    \"fullName\": \"Karthik Rao\",\n    \"email\": \"karthik.rao@example.com\",\n    \"phone\": \"9876500004\",\n    \"dateOfBirth\": \"1995-02-14\",\n    \"pan\": \"CKRPR7788Q\"\n  },\n  \"accountType\": \"SAVINGS\",\n  \"initialDeposit\": \"15000.00\"\n}"},"url":"{{baseUrl}}/accounts"}},
    {"name":"Transfer","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Idempotency-Key","value":"{{idempotencyKey}}"}],"body":{"mode":"raw","raw":"{\n  \"fromAccountNumber\": \"{{accountNumber}}\",\n  \"toAccountNumber\": \"{{toAccountNumber}}\",\n  \"amount\": \"2500.00\",\n  \"remarks\": \"Postman demo\"\n}"},"url":"{{baseUrl}}/transfers"}},
    {"name":"Transfer lookup","request":{"method":"GET","url":"{{baseUrl}}/transfers/{{referenceNo}}"}},
    {"name":"September statement","request":{"method":"GET","url":"{{baseUrl}}/accounts/{{accountNumber}}/statement?fromDate=2026-09-01&toDate=2026-09-30&page=0&size=20"}}
  ]
}
